[Unit]
Description=TBOTS research verification receipts (weekday checks; expire with the Friday expiry)

[Timer]
OnCalendar=Mon..Fri *-*-* 09:46:00 America/New_York
OnCalendar=Mon..Fri *-*-* 16:32:00 America/New_York
