[Unit]
Description=TBOTS capture verification receipts (weekday checks; expire with the Friday expiry)

[Timer]
OnCalendar=Mon..Fri *-*-* 09:41:00 America/New_York
OnCalendar=Mon..Fri *-*-* 16:27:00 America/New_York
Persistent=false
AccuracySec=1s
Unit=tbots-foodfuel-verify-capture.service

[Install]
WantedBy=timers.target
